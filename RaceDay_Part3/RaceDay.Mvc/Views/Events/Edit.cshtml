@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}
<h1 class="mb-4">Edit event</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form asp-action="Edit" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" class="col-md-8">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("_EventForm", Model)
    <button type="submit" class="btn btn-raceday">Save changes</button>
    <a class="btn btn-outline-secondary" asp-controller="Categories" asp-action="Create" asp-route-eventId="@Model.EventId">+ Add category</a>
</form>
