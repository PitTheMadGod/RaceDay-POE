@model List<(EventDto Event, int EnrolmentCount)>
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Your dashboard</h1>
    <a class="btn btn-raceday" asp-controller="Events" asp-action="Create">+ New event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm text-center p-3">
            <div class="display-6">@Model.Count</div>
            <div class="text-muted">Events created</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm text-center p-3">
            <div class="display-6">@Model.Sum(r => r.EnrolmentCount)</div>
            <div class="text-muted">Total enrolments</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm text-center p-3">
            <div class="display-6">@Model.Count(r => r.Event.EventDate >= DateTime.Today)</div>
            <div class="text-muted">Upcoming events</div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">You haven't created any events yet. <a asp-controller="Events" asp-action="Create">Create your first one</a>.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Enrolments</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.OrderBy(r => r.Event.EventDate))
            {
                <tr>
                    <td>@row.Event.Name <span class="badge bg-event-type">@row.Event.EventType</span></td>
                    <td>@row.Event.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@row.EnrolmentCount</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Enrolments" asp-action="ForEvent" asp-route-eventId="@row.Event.EventId">View enrolments</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Events" asp-action="Edit" asp-route-id="@row.Event.EventId">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
