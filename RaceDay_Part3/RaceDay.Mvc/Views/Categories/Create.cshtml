@model CategoryFormViewModel
@{
    ViewData["Title"] = "Add category";
}
<h1 class="mb-4">Add category to "@Model.EventName"</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form asp-action="Create" method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EventId" />
    <input type="hidden" asp-for="EventName" />

    <div class="mb-3">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" placeholder="e.g. Under-20 Male" />
        <span asp-validation-for="CategoryName" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="MinAge" class="form-label"></label>
            <input asp-for="MinAge" type="number" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="MaxAge" class="form-label"></label>
            <input asp-for="MaxAge" type="number" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="CategoryDistance" class="form-label">Distance (km)</label>
            <input asp-for="CategoryDistance" type="number" step="0.1" class="form-control" />
        </div>
    </div>
    <button type="submit" class="btn btn-raceday">Add category</button>
    <a class="btn btn-outline-secondary" asp-controller="Events" asp-action="Edit" asp-route-id="@Model.EventId">Back to event</a>
</form>
