@model List<EventDto>
@{
    ViewData["Title"] = "Upcoming events";
}
<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
    <div>
        <h1 class="mb-1">Upcoming events</h1>
        <p class="text-muted mb-0">Find a race, walk or ride and get enrolled.</p>
    </div>
    <form method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name or location" />
        <select name="eventType" class="form-select">
            <option value="">All types</option>
            <option value="Run" selected="@(ViewBag.EventType == "Run")">Run</option>
            <option value="Walk" selected="@(ViewBag.EventType == "Walk")">Walk</option>
            <option value="Cycle" selected="@(ViewBag.EventType == "Cycle")">Cycle</option>
        </select>
        <button type="submit" class="btn btn-raceday">Filter</button>
    </form>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No upcoming events match your filters.</p>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm event-card">
                    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name banner" />
                    }
                    else
                    {
                        <div class="card-img-top event-card-placeholder">@ev.EventType</div>
                    }
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-event-type mb-2 align-self-start">@ev.EventType</span>
                        <h5 class="card-title">@ev.Name</h5>
                        <p class="card-text text-muted mb-1">📍 @ev.Location</p>
                        <p class="card-text text-muted mb-3">📅 @ev.EventDate.ToString("dd MMM yyyy") &middot; @ev.Distance km</p>
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-raceday mt-auto">View event</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
